---
import CallToAction from "./ui/CallToAction.astro";
import { closing, contact, name } from "../data";

// Rolls over on its own each January rather than needing an edit.
const year = new Date().getFullYear();
---

<footer id="contact" class="mt-section border-t border-line pt-12">
    <p class="max-w-[54ch] text-pretty text-lead text-muted">{closing}</p>

    <CallToAction emailLabel={contact.email} />

    <div class="mt-14 flex flex-col gap-2 border-t border-line pt-6 text-micro text-faint sm:flex-row sm:items-center sm:justify-between">
        <p>
            © {year} {name}
        </p>
    </div>
</footer>
