---
// The last row of the activity card. It is deliberately not a standalone
// box: it fills the card's width, so a track title — arbitrary text that
// changes every few minutes — can never resize anything. Long titles
// truncate against a container that was already there.
//
// Hidden until the fetch succeeds. When nothing is playing the row and its
// divider disappear together, leaving the card looking untouched.
---
<a
  data-now-playing
  hidden
  href="#"
  target="_blank"
  rel="noopener"
  class="group flex w-full items-center gap-3 border-t border-line px-5 py-4 no-underline transition-colors duration-200 hover:bg-panel-hover sm:px-6"
>
  <img
    data-np-art
    alt=""
    width="72"
    height="72"
    class="size-9 shrink-0 rounded-[6px] bg-bg object-cover"
  />

  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-1.5">
      <!-- Bars animate only while something is actually playing. -->
      <span data-np-bars class="flex h-2.5 items-end gap-[2px]" aria-hidden="true">
        <i class="w-[2px] rounded-full bg-muted"></i>
        <i class="w-[2px] rounded-full bg-muted"></i>
        <i class="w-[2px] rounded-full bg-muted"></i>
      </span>
      <span data-np-label class="text-micro uppercase tracking-[0.14em] text-faint"></span>
    </span>

    <span class="mt-1 block truncate text-meta text-fg">
      <span data-np-title class="font-medium"></span>
      <span data-np-artist class="text-muted"></span>
    </span>
  </span>

  <!-- Same affordance the project cards use: the arrow only shows up once
       the row is worth clicking. -->
  <svg
    class="size-3.5 shrink-0 text-faint opacity-0 transition-opacity duration-200 group-hover:opacity-100"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5.5 10.5 10.5 5.5M6.5 5.5h4v4" />
  </svg>
</a>

<script>
  type Track = {
    isPlaying?: boolean;
    title?: string;
    artist?: string;
    art?: string | null;
    url?: string | null;
    playedAt?: string | null;
  };

  const root = document.querySelector<HTMLAnchorElement>("[data-now-playing]");

  if (root) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const art = q<HTMLImageElement>("[data-np-art]");
    const bars = q<HTMLElement>("[data-np-bars]");
    const label = q<HTMLElement>("[data-np-label]");
    const title = q<HTMLElement>("[data-np-title]");
    const artist = q<HTMLElement>("[data-np-artist]");

    const ago = (iso: string) => {
      const mins = Math.round((Date.now() - Date.parse(iso)) / 60000);
      if (!Number.isFinite(mins) || mins < 1) return "just now";
      if (mins < 60) return `${mins}m ago`;
      const hrs = Math.round(mins / 60);
      return hrs < 24 ? `${hrs}h ago` : `${Math.round(hrs / 24)}d ago`;
    };

    const render = (t: Track) => {
      // No title means unconfigured, idle or unreachable — all the same to
      // the page: show nothing rather than a broken widget.
      if (!t.title) {
        root.hidden = true;
        return;
      }

      title.textContent = t.title;
      artist.textContent = t.artist ? ` — ${t.artist}` : "";
      // The visible line truncates, so keep the full text on hover.
      root.title = t.artist ? `${t.title} — ${t.artist}` : t.title;

      label.textContent = t.isPlaying
        ? "Now playing"
        : t.playedAt
          ? `Last played · ${ago(t.playedAt)}`
          : "Last played";

      bars.classList.toggle("is-playing", Boolean(t.isPlaying));

      if (t.art) {
        art.src = t.art;
        art.hidden = false;
      } else {
        art.hidden = true;
      }

      if (t.url) {
        root.href = t.url;
      } else {
        root.removeAttribute("href");
      }

      root.hidden = false;
    };

    const poll = async () => {
      try {
        const res = await fetch("/api/now-playing");
        if (!res.ok) return;
        render((await res.json()) as Track);
      } catch {
        // Offline or the function is down; leave whatever is on screen.
      }
    };

    poll();
    // Matches the endpoint's 30s edge cache — polling faster only adds load.
    const timer = setInterval(poll, 30_000);
    // Tabs left open for hours shouldn't keep polling in the background.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") poll();
    });
    window.addEventListener("pagehide", () => clearInterval(timer));
  }
</script>
