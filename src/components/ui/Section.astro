---
type Props = { title: string; id: string; center?: boolean };
const { title, id, center = false } = Astro.props;
---
<section
  aria-labelledby={id}
  class:list={["mt-[clamp(3.5rem,9vw,5rem)]", center ? "text-center" : "text-left"]}
>
  <h2
    id={id}
    data-reveal
    class="mb-6 text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted"
  >
    {title}
  </h2>
  <div data-reveal style="--i: 1">
    <slot />
  </div>
</section>
