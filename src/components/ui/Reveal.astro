---
/* Reveals [data-reveal] elements as they scroll into view. Children of a
   [data-reveal-group] are revealed one by one. Lives in <head> so the hidden
   state is set before first paint — no flash of unstyled content. */
---
<script is:inline>
  (() => {
    if (!("IntersectionObserver" in window)) return;

    document.documentElement.classList.add("reveal-ready");

    const start = () => {
      const targets = [...document.querySelectorAll("[data-reveal]")];

      for (const group of document.querySelectorAll("[data-reveal-group]")) {
        [...group.children].forEach((child, i) => {
          child.setAttribute("data-reveal", "");
          child.style.setProperty("--i", String(i));
          targets.push(child);
        });
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
      );

      targets.forEach((el) => io.observe(el));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }
  })();
</script>
