---
import type { Icon } from "../../types";

type Props = Icon & { label: string; size?: number };
const { svg, brandDark, brandLight, label, size = 22 } = Astro.props;
---
<span
  class="grid place-items-center [&_svg]:block [&_svg]:size-(--icon-size)"
  title={label}
  style={[
    `--icon-size:${size}px`,
    brandDark && `--brand-d:${brandDark};--brand-l:${brandLight}`,
  ]
    .filter(Boolean)
    .join(";")}
>
  {svg ? <Fragment set:html={svg} /> : <b class="text-base font-semibold">{label[0]}</b>}
</span>
