---
import { contact } from "../../data";

type Props = { emailLabel?: string; center?: boolean };
const { emailLabel = "Email me", center = false } = Astro.props;
---
<div class:list={["mt-7 flex flex-wrap gap-2.5", center && "justify-center"]}>
  <a class="btn" href={contact.call} target="_blank" rel="noopener">
    Book a call
    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" />
    </svg>
  </a>
  <a class="btn btn-ghost" href={`mailto:${contact.email}`}>{emailLabel}</a>
</div>
