---
import { contact } from "../../data";

type Props = { emailLabel?: string };
const { emailLabel = "Email me" } = Astro.props;
---
<div class="mt-7 flex flex-wrap justify-center gap-2.5">
  <a class="btn" href={contact.call} target="_blank" rel="noopener">Book a call</a>
  <a class="btn btn-ghost" href={`mailto:${contact.email}`}>{emailLabel}</a>
</div>
