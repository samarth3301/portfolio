---
import type { Day } from "../../types";

type Props = { days: Day[]; total: number };
const { days, total } = Astro.props;

// Pad to a whole week so the grid columns line up with real weekdays.
const lead = days.length ? new Date(days[0]!.date + "T00:00:00Z").getUTCDay() : 0;
const cells: (Day | null)[] = [...Array(lead).fill(null), ...days];

const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
// One label per column whose week contains the 1st of a month.
const months: { col: number; name: string }[] = [];
for (let i = 0; i < cells.length; i++) {
  const d = cells[i];
  if (!d) continue;
  const day = new Date(d.date + "T00:00:00Z");
  if (day.getUTCDate() <= 7) {
    const col = Math.floor(i / 7) + 1;
    const name = MONTHS[day.getUTCMonth()]!;
    if (months.at(-1)?.name !== name) months.push({ col, name });
  }
}
const weeks = Math.ceil(cells.length / 7);

const LEVELS = ["bg-l0", "bg-l1", "bg-l2", "bg-l3", "bg-l4"];

function formatDate(dateStr: string) {
  const d = new Date(dateStr + "T00:00:00Z");
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
}
---

<figure class="m-0 relative group/contrib" style={`--weeks:${weeks}`}>
  <figcaption class="mb-3.5 text-[0.85rem] text-muted">
    <strong class="font-semibold text-fg">{total.toLocaleString()}</strong>
    contributions in the last year
  </figcaption>

  <!-- Tooltip element -->
  <div
    id="contrib-tooltip"
    class="pointer-events-none fixed z-50 hidden rounded-md bg-panel border border-line px-2.5 py-1 text-xs text-fg shadow-lg transition-opacity duration-150 whitespace-nowrap"
    role="tooltip"
  >
    <span id="contrib-tooltip-text" class="font-medium"></span>
  </div>

  <!-- Narrow screens scroll horizontally at a legible fixed cell size; from
       sm up the whole year fits the container with fluid columns. -->
  <div class="-mx-1 overflow-x-auto px-1 sm:mx-0 sm:overflow-x-visible sm:px-0">
  <div class="min-w-[calc(var(--weeks)*11px)] sm:min-w-0">
  <div
    class="mb-1.5 grid h-[1em] grid-cols-[repeat(var(--weeks),1fr)] gap-[clamp(1px,0.32vw,3px)] text-[0.68rem] leading-none text-muted"
    aria-hidden="true"
  >
    {months.map((m) => (
      <span class="whitespace-nowrap" style={`grid-column:${m.col}`}>{m.name}</span>
    ))}
  </div>

  <!-- aspect-ratio on the container, not the cells: a cell sized only by
       aspect-ratio collapses to zero height inside a grid track. -->
  <div
    id="contrib-grid"
    class="grid aspect-[var(--weeks)/7] grid-flow-col grid-cols-[repeat(var(--weeks),1fr)] grid-rows-7 gap-[clamp(1px,0.32vw,3px)]"
    role="img"
    aria-label={`${total} GitHub contributions in the last year`}
  >
    {cells.map((d) =>
      d ? (
        <i
          class:list={["contrib-cell min-w-0 rounded-[2px] transition duration-150 hover:scale-160 cursor-pointer", LEVELS[d.level]]}
          data-count={d.count}
          data-date={formatDate(d.date)}
          title={`${d.count} contribution${d.count === 1 ? "" : "s"} on ${formatDate(d.date)}`}
        ></i>
      ) : (
        <i class="min-w-0"></i>
      ),
    )}
  </div>
  </div>
  </div>

  <div class="mt-3.5 flex items-center justify-end gap-1 text-[0.7rem] text-muted">
    <span class="mr-0.5">Less</span>
    {LEVELS.map((bg) => <i class:list={["size-2.5 rounded-[2px]", bg]}></i>)}
    <span class="ml-0.5">More</span>
  </div>
</figure>

<script>
  const tooltip = document.getElementById("contrib-tooltip");
  const tooltipText = document.getElementById("contrib-tooltip-text");
  const grid = document.getElementById("contrib-grid");

  if (tooltip && tooltipText && grid) {
    grid.addEventListener("mouseover", (e) => {
      const target = e.target as HTMLElement;
      if (target && target.classList.contains("contrib-cell")) {
        const count = target.getAttribute("data-count");
        const date = target.getAttribute("data-date");
        if (count !== null && date) {
          const countText = count === "0" ? "No contributions" : `${count} contribution${count === "1" ? "" : "s"}`;
          tooltipText.textContent = `${countText} on ${date}`;
          tooltip.classList.remove("hidden");
        }
      }
    });

    grid.addEventListener("mousemove", (e) => {
      if (!tooltip.classList.contains("hidden")) {
        const x = e.clientX;
        const y = e.clientY;
        tooltip.style.left = `${x}px`;
        tooltip.style.top = `${y - 36}px`;
        tooltip.style.transform = "translateX(-50%)";
      }
    });

    grid.addEventListener("mouseout", (e) => {
      const target = e.target as HTMLElement;
      if (target && target.classList.contains("contrib-cell")) {
        tooltip.classList.add("hidden");
      }
    });
  }
</script>
