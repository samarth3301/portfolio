---
import { Image } from "astro:assets";
import Tags from "../ui/Tags.astro";
import { experience } from "../../data";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/logos/*.{png,jpg,jpeg,webp,svg}",
  { eager: true },
);

const slug = (org: string) => org.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const logoFor = (org: string) =>
  Object.entries(logos).find(([path]) => path.split("/").pop()!.split(".")[0] === slug(org))?.[1].default;

const tiles: Record<string, string> = {
  inboxkit: "bg-white p-1.5",
  techsolace: "bg-black p-1.5",
};
const tileFor = (org: string) => tiles[slug(org)] ?? "bg-bg";

const initials = (org: string) => org.slice(0, 2).toUpperCase();
---
<ol data-reveal-group class="m-0 grid list-none gap-9 p-0">
  {experience.map((e) => {
    const single = e.roles.length === 1;
    const lead = e.roles[0];
    const logo = logoFor(e.org);
    return (
      <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 not-last:border-b not-last:border-line not-last:pb-9">
        {logo ? (
          <Image src={logo} alt="" width={80} height={80} class={`size-10 rounded-md border border-line object-contain ${tileFor(e.org)}`} />
        ) : (
          <span
            aria-hidden="true"
            class="grid size-10 place-items-center rounded-md border border-line bg-bg font-mono text-micro text-muted"
          >
            {initials(e.org)}
          </span>
        )}

        <div>
          {single ? (
            <>
              <h3 class="text-body font-semibold">{lead.title}</h3>
              <p class="text-body">
                {e.url ? (
                  <a href={e.url} target="_blank" rel="noopener" class="no-underline underline-offset-4 hover:underline">{e.org}</a>
                ) : (
                  e.org
                )}
                {lead.type && <span class="text-muted"> · {lead.type}</span>}
              </p>
              <p class="text-meta text-faint">{lead.period} · {lead.duration}</p>
              {lead.location && <p class="text-meta text-faint">{lead.location}</p>}
              <p class="mt-3 mb-3.5 max-w-[70ch] text-pretty text-body text-muted">{lead.blurb}</p>
              <Tags items={lead.tags} />
            </>
          ) : (
            <>
              <h3 class="text-body font-semibold">
                {e.url ? (
                  <a href={e.url} target="_blank" rel="noopener" class="no-underline underline-offset-4 hover:underline">{e.org}</a>
                ) : (
                  e.org
                )}
              </h3>
              <p class="text-body">{e.period}</p>
              {lead.location && <p class="text-meta text-faint">{lead.location}</p>}

              <ol class="relative m-0 mt-5 grid list-none gap-6 p-0">
                <span aria-hidden="true" class="absolute bottom-2 left-0.75 top-2 w-px bg-line"></span>
                {e.roles.map((r) => (
                  <li class="relative pl-5">
                    <span
                      aria-hidden="true"
                      class="absolute left-0 top-2 size-1.75 rounded-full bg-line-strong"
                    ></span>
                    <h4 class="text-body font-semibold">{r.title}</h4>
                    {r.type && <p class="text-body">{r.type}</p>}
                    <p class="text-meta text-faint">{r.period} · {r.duration}</p>
                    <p class="mt-2 mb-3 max-w-[70ch] text-pretty text-body text-muted">{r.blurb}</p>
                    <Tags items={r.tags} />
                  </li>
                ))}
              </ol>
            </>
          )}
        </div>
      </li>
    );
  })}
</ol>
