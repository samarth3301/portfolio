---
import Tags from "../ui/Tags.astro";
import type { ResolvedProject } from "../../types";

type Props = { project: ResolvedProject };
const { project: p } = Astro.props;
---
<article
  class:list={[
    "card card-interactive group relative flex flex-col p-5",
    // The work worth reading first spans the full row.
    p.highlight && "sm:col-span-2",
  ]}
>
  <div class="mb-2.5 flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold tracking-[-0.01em]">
      {p.url ? (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 no-underline after:absolute after:inset-0 after:content-['']"
        >
          {p.name}
          <svg
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="text-faint opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg group-hover:opacity-100"
          >
            <path d="M5.5 10.5 10.5 5.5M6 5.5h4.5V10" />
          </svg>
        </a>
      ) : (
        p.name
      )}
    </h3>
    {p.stars > 0 && (
      <span class="inline-flex shrink-0 items-center gap-1 font-mono text-micro text-faint">
        <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" aria-hidden="true">
          <path d="M8 1.5l1.9 4 4.4.6-3.2 3.1.8 4.3L8 11.4l-3.9 2.1.8-4.3L1.7 6.1l4.4-.6z" />
        </svg>
        {p.stars}
      </span>
    )}
  </div>

  <p class="mb-4 flex-1 text-pretty text-meta text-muted">
    {p.blurb}
  </p>

  <Tags items={p.tags} />

  <!-- Secondary links sit above the card-wide overlay link so they stay
       independently clickable. -->
  {(p.homepage || p.more) && (
    <div class="relative z-10 mt-4 flex flex-wrap gap-4 text-meta [&_a]:text-muted [&_a]:no-underline [&_a]:underline-offset-4 [&_a:hover]:text-fg [&_a:hover]:underline">
      {p.homepage && <a href={p.homepage} target="_blank" rel="noopener">Live site</a>}
      {p.more && <a href={p.more.href} target="_blank" rel="noopener">{p.more.label}</a>}
    </div>
  )}
</article>
