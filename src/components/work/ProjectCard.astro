---
import Tags from "../ui/Tags.astro";
import type { ResolvedProject } from "../../types";

type Props = { project: ResolvedProject };
const { project: p } = Astro.props;
---
<article
  class:list={[
    "surface flex flex-col rounded-xl p-[1.1rem] transition duration-150 hover:-translate-y-0.5 hover:border-accent",
    // The work worth reading first spans the full row.
    p.highlight && "sm:col-span-2",
  ]}
>
  <div class="mb-2 flex items-baseline justify-between gap-2.5">
    <h3 class="text-base font-semibold">
      {p.url ? (
        <a href={p.url} target="_blank" rel="noopener" class="no-underline hover:text-accent">
          {p.name}
        </a>
      ) : (
        p.name
      )}
    </h3>
    {p.stars > 0 && <span class="text-xs text-muted">★ {p.stars}</span>}
  </div>

  <p class="mb-3.5 flex-1 text-pretty text-[0.87rem] leading-relaxed text-muted">
    {p.blurb}
  </p>

  <Tags items={p.tags} />

  <div class="mt-3.5 flex flex-wrap gap-3.5 text-[0.78rem] text-accent [&_a]:no-underline [&_a]:underline-offset-[3px] [&_a:hover]:underline">
    {p.homepage && <a href={p.homepage} target="_blank" rel="noopener">Live site</a>}
    {p.url && <a href={p.url} target="_blank" rel="noopener">Source</a>}
    {p.more && <a href={p.more.href} target="_blank" rel="noopener">{p.more.label}</a>}
  </div>
</article>
