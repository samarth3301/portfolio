---
import Icon from "../ui/Icon.astro";
import type { StackItem, WithIcon } from "../../types";

type Props = { groups: { group: string; items: WithIcon<StackItem>[] }[] };
const { groups } = Astro.props;
---
<div data-reveal-group class="grid gap-8">
  {groups.map((g) => (
    <div>
      <h3 class="mb-4 flex items-center gap-3 text-micro font-medium uppercase tracking-[0.14em] text-faint">
        {g.group}
        <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
      </h3>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(4.5rem,1fr))] gap-1.5 p-0">
        {g.items.map((item) => (
          <li
            class="group grid justify-items-center gap-2 rounded-card border border-transparent px-1 py-3 transition-colors duration-200 hover:border-line hover:bg-panel"
          >
            {/* Desaturated at rest so the grid reads as one block; hover restores the brand colour. */}
            <span
              class="grid size-8 place-items-center [&_svg]:opacity-60 [&_svg]:grayscale [&_svg]:transition-[filter,opacity] [&_svg]:duration-200 group-hover:[&_svg]:opacity-100 group-hover:[&_svg]:grayscale-0"
            >
              <Icon {...item} label={item.name} size={20} />
            </span>
            <span class="text-center text-micro text-faint transition-colors duration-200 group-hover:text-fg">
              {item.name}
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
