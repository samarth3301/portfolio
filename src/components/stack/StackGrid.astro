---
import Icon from "../ui/Icon.astro";
import type { StackItem, WithIcon } from "../../types";

type Props = { groups: { group: string; items: WithIcon<StackItem>[] }[] };
const { groups } = Astro.props;
---
<div data-reveal-group class="grid gap-6">
  {groups.map((g) => (
    <div>
      <h3 class="mb-3 text-center text-[0.7rem] font-medium uppercase tracking-[0.14em] text-muted">
        {g.group}
      </h3>
      <ul class="m-0 flex list-none flex-wrap justify-center gap-3 p-0">
        {g.items.map((item) => (
          <li class="group grid justify-items-center gap-1.5">
            {/* Desaturated at rest so the grid reads as one block; hover restores the brand colour. */}
            <span
              class="grid size-[46px] place-items-center rounded-xl border border-line bg-panel transition duration-200 [&_svg]:opacity-70 [&_svg]:grayscale [&_svg]:transition-[filter,opacity] [&_svg]:duration-200 sm:size-[52px] group-hover:-translate-y-0.5 group-hover:border-accent-dim group-hover:[&_svg]:opacity-100 group-hover:[&_svg]:grayscale-0 group-focus-within:-translate-y-0.5 group-focus-within:border-accent-dim group-focus-within:[&_svg]:opacity-100 group-focus-within:[&_svg]:grayscale-0"
            >
              <Icon {...item} label={item.name} />
            </span>
            <span class="text-[0.68rem] text-muted">{item.name}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
