---
import Icon from "../ui/Icon.astro";
import type { SocialLink, WithIcon } from "../../types";

type Props = { links: WithIcon<SocialLink>[] };
const { links } = Astro.props;
---
<nav aria-label="Elsewhere" class="mt-6 flex flex-wrap justify-center gap-2">
  {links.map((l) => (
    <a
      href={l.href}
      rel="me noopener"
      target="_blank"
      aria-label={l.label}
      class="grid size-[38px] place-items-center rounded-full no-underline transition duration-200 [&_svg]:opacity-70 [&_svg]:grayscale [&_svg]:transition-[filter,opacity] [&_svg]:duration-200 hover:-translate-y-0.5 hover:bg-panel hover:[&_svg]:opacity-100 hover:[&_svg]:grayscale-0"
    >
      <Icon {...l} label={l.label} size={18} />
    </a>
  ))}
</nav>
