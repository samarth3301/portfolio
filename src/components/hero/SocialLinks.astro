---
import Icon from "../ui/Icon.astro";
import type { SocialLink, WithIcon } from "../../types";

type Props = { links: WithIcon<SocialLink>[] };
const { links } = Astro.props;
---
<nav aria-label="Elsewhere" class="mt-7 flex flex-wrap gap-1">
  {links.map((l) => (
    <a
      href={l.href}
      rel="me noopener"
      target="_blank"
      aria-label={l.label}
      class="group -ml-2 grid size-9 place-items-center rounded-control text-muted no-underline transition-colors duration-200 first:ml-0 hover:bg-panel hover:text-fg [&_svg]:opacity-70 [&_svg]:grayscale [&_svg]:transition-[filter,opacity] [&_svg]:duration-200 hover:[&_svg]:opacity-100 hover:[&_svg]:grayscale-0"
    >
      <Icon {...l} label={l.label} size={18} />
    </a>
  ))}
</nav>
