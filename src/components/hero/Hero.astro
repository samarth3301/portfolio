---
import { Image } from "astro:assets";
import SocialLinks from "./SocialLinks.astro";
import CallToAction from "../ui/CallToAction.astro";
import { name, role, location, availability, subpitch } from "../../data";
import type { SocialLink, WithIcon } from "../../types";

type Props = { avatar: ImageMetadata; socials: WithIcon<SocialLink>[] };
const { avatar, socials } = Astro.props;
---
<header data-reveal-group>
  <div class="flex items-center gap-4">
    <!-- Sized at 2x the rendered box for retina, height left to the source
         aspect ratio and cropped square by object-cover. Astro resizes and
         re-encodes at build time so the 1.4MB original never ships. -->
    <Image
      src={avatar}
      alt={name}
      width={144}
      loading="eager"
      class="size-[72px] shrink-0 rounded-full border border-line bg-panel object-cover"
    />
    <div class="min-w-0">
      <h1 class="text-[clamp(1.75rem,5vw,2.4rem)] font-bold leading-[1.1] tracking-[-0.035em]">
        {name}
      </h1>
      <p class="mt-1 text-body text-muted">{role}</p>
    </div>
  </div>

  <p class="mt-7 max-w-[70ch] text-pretty text-body text-muted">
    {subpitch}
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <span class="badge">{location}</span>
    <span class="badge">
      <!-- Ping ring plus a solid core, so the dot reads as a live signal. -->
      <span class="relative grid size-1.5 place-items-center">
        <span class="absolute size-1.5 animate-ping rounded-full bg-fg opacity-70"></span>
        <span class="size-1.5 rounded-full bg-fg"></span>
      </span>
      {availability}
    </span>
  </div>

  <SocialLinks links={socials} />
  <CallToAction />
</header>
