---
// Must render inside <head>: sets the theme before first paint so a stored
// choice never flashes. Dark is the default when nothing is stored.
---
<script is:inline>
  (() => {
    let theme = "dark";
    try {
      const saved = localStorage.getItem("theme");
      if (saved === "light" || saved === "dark") theme = saved;
    } catch {}
    document.documentElement.dataset.theme = theme;
  })();
</script>
